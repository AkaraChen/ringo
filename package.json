{
    "name": "@akrc/ringo",
    "version": "2.0.0",
    "description": "Framework-agnostic popup primitives (message, notice, dialog, drawer) as Web Components.",
    "type": "module",
    "license": "MIT",
    "author": "AkaraChen",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AkaraChen/ringo.git"
    },
    "homepage": "https://ringo.js.org",
    "bugs": {
        "url": "https://github.com/AkaraChen/ringo/issues"
    },
    "keywords": [
        "message",
        "notice",
        "dialog",
        "drawer",
        "toast",
        "web-components",
        "typescript"
    ],
    "packageManager": "pnpm@10.33.3",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./message": {
            "types": "./dist/message.d.ts",
            "import": "./dist/message.js",
            "require": "./dist/message.cjs"
        },
        "./notice": {
            "types": "./dist/notice.d.ts",
            "import": "./dist/notice.js",
            "require": "./dist/notice.cjs"
        },
        "./dialog": {
            "types": "./dist/dialog.d.ts",
            "import": "./dist/dialog.js",
            "require": "./dist/dialog.cjs"
        },
        "./drawer": {
            "types": "./dist/drawer.d.ts",
            "import": "./dist/drawer.js",
            "require": "./dist/drawer.cjs"
        },
        "./backdrop": {
            "types": "./dist/backdrop.d.ts",
            "import": "./dist/backdrop.js",
            "require": "./dist/backdrop.cjs"
        },
        "./style/*": "./style/*"
    },
    "files": [
        "dist",
        "style"
    ],
    "scripts": {
        "prepare": "husky",
        "dev": "vite",
        "build": "tsup",
        "lint": "eslint .",
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@types/node": "^22.18.0",
        "eslint": "^9.34.0",
        "happy-dom": "^18.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.5",
        "motion": "^10.18.0",
        "prettier": "^3.6.2",
        "tsup": "^8.5.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.41.0",
        "vite": "^7.1.3",
        "vitepress": "^1.6.4",
        "vitest": "^3.2.4",
        "vue": "^3.5.20"
    },
    "lint-staged": {
        "*.{ts,js,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,yml,yaml}": [
            "prettier --write"
        ]
    }
}
